<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AppleNotes.AndroidApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Notes Cable Transfer</ApplicationTitle>
    <ApplicationId>org.opzet.notescable</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" />
    <ProjectReference Include="../AppleNotes.Core/AppleNotes.Core.csproj" />
    <AndroidNativeLibrary Include="../native/output/arm64-v8a/libnotesusb.so" />
    <MauiAsset Include="../native/output/licenses/**" LogicalName="licenses/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireUsbBackend" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../native/output/arm64-v8a/libnotesusb.so')"
           Text="Build the direct-USB backend first: bash Maui/native/build.sh android" />
  </Target>
</Project>
